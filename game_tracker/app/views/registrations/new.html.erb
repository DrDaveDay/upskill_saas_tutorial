<% content_for :title, "Sign up · Puzzle Cup" %>
<div class="form-narrow">
  <h1>Create your account</h1>
  <p class="muted">Then create a group or join one with an invite link.</p>
  <div class="card">
    <%= render "shared/errors", record: @user %>
    <%= form_with model: @user, url: registration_path do |f| %>
      <div class="field"><%= f.label :name, "Your name (shown on leaderboards)" %><%= f.text_field :name, required: true, autofocus: true, maxlength: 40 %></div>
      <div class="field"><%= f.label :email_address, "Email" %><%= f.email_field :email_address, required: true, autocomplete: "username" %></div>
      <div class="field"><%= f.label :password %><%= f.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password" %></div>
      <div class="field"><%= f.label :password_confirmation, "Confirm password" %><%= f.password_field :password_confirmation, required: true, maxlength: 72, autocomplete: "new-password" %></div>
      <%= f.submit "Sign up", class: "btn btn--primary btn--block" %>
    <% end %>
  </div>
  <p class="muted small" style="text-align:center">Already have an account? <%= link_to "Sign in", new_session_path %></p>
</div>
